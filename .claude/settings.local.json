{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "rtk hook claude" }]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "disableBundledSkills": true,
  "spinnerTipsEnabled": false,

  "claudeMdExcludes": [
    "C:/Users/*/.claude/*.md",
    "C:/Users/*/CLAUDE.md",
    "/Users/*/.claude/*.md",
    "/Users/*/CLAUDE.md",
    "/home/*/.claude/*.md",
    "/home/*/CLAUDE.md"
  ],

  "enabledPlugins": {
    "engineering-skills@claude-code-skills": false,
    "engineering-advanced-skills@claude-code-skills": false,
    "product-skills@claude-code-skills": false,
    "code-to-prd@claude-code-skills": false,
    "antigravity-awesome-skills@antigravity-awesome-skills": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "claude-mem@thedotmack": false
  },

  "skillOverrides": {
    "amazon-bedrock": "off",
    "aws-ai-ml": "off",
    "aws-auth": "off",
    "aws-billing-and-cost-management": "off",
    "aws-blocks": "off",
    "aws-cdk": "off",
    "aws-cloudformation": "off",
    "aws-compute": "off",
    "aws-containers": "off",
    "aws-database": "off",
    "aws-deployment": "off",
    "aws-iam": "off",
    "aws-messaging-and-streaming": "off",
    "aws-networking": "off",
    "aws-observability": "off",
    "aws-sdk-js-v3-usage": "off",
    "aws-sdk-python-usage": "off",
    "aws-sdk-swift-usage": "off",
    "aws-security": "off",
    "aws-serverless": "off",
    "aws-storage": "off",
    "caveman-talk": "off",
    "design-figma": "off",
    "dod-task": "off",
    "launch-with-aws": "off",
    "nuovo-progetto-design": "off",
    "signing-in-to-aws": "off",
    "zoho-bug-WF": "off"
  },

  "permissions": {
    "deny": ["Agent(git-project-initializer)"]
  },

  "deniedMcpServers": [
    { "serverName": "develop" },
    { "serverName": "develop_new" },
    { "serverName": "aws-mcp" },
    { "serverName": "mysql-catalog-saas" },
    { "serverName": "playwright" },
    { "serverName": "claude-design" },
    { "serverName": "chrome-devtools" },
    { "serverName": "azure-devops" },
    { "serverName": "claude.ai Asana" },
    { "serverName": "claude.ai Atlassian" },
    { "serverName": "claude.ai Box" },
    { "serverName": "claude.ai Canva" },
    { "serverName": "claude.ai Claude Data" },
    { "serverName": "claude.ai Claude Docs" },
    { "serverName": "claude.ai Context7" },
    { "serverName": "claude.ai Gmail" },
    { "serverName": "claude.ai Google Calendar" },
    { "serverName": "claude.ai Google Docs" },
    { "serverName": "claude.ai Google Drive" },
    { "serverName": "claude.ai Google Sheets" },
    { "serverName": "claude.ai Google Slides" },
    { "serverName": "claude.ai HubSpot" },
    { "serverName": "claude.ai Intercom" },
    { "serverName": "claude.ai Linear" },
    { "serverName": "claude.ai Meetings" },
    { "serverName": "claude.ai Microsoft 365" },
    { "serverName": "claude.ai Microsoft Learn" },
    { "serverName": "claude.ai Notion" },
    { "serverName": "claude.ai Postman" },
    { "serverName": "claude.ai Slack" },
    { "serverName": "claude.ai Zoho Projects" },
    { "serverName": "claude.ai Zoom for Claude" },
    { "serverName": "claude.ai monday.com" }
  ]
}
